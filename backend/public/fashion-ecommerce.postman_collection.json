              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "try {",
                    "  const json = pm.response.json();",
                    "  const tokens = json?.metadata;",
                    "  if (tokens?.accessToken) {",
                    "    pm.collectionVariables.set('accessToken', tokens.accessToken);",
                    "    pm.environment.set('accessToken', tokens.accessToken);",
                    "  }",
                    "  if (tokens?.refreshToken) {",
                    "    pm.collectionVariables.set('refreshToken', tokens.refreshToken);",
                    "    pm.environment.set('refreshToken', tokens.refreshToken);",
                    "  }",
                    "} catch (e) {}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
